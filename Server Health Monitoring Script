# Server Health Monitoring Script

## Objective

Monitor Linux server health and generate a report.

## Features

- CPU Usage
- Memory Usage
- Disk Usage
- Load Average
- Running Services
- Top CPU Processes
- Top Memory Processes
- Log Generation

## Run

#!/bin/bash

#############################################
# Server Health Monitoring Script
#############################################

LOG_DIR="./logs"
LOG_FILE="$LOG_DIR/health-report.log"

mkdir -p "$LOG_DIR"

echo "==========================================" | tee -a "$LOG_FILE"
echo "SERVER HEALTH REPORT" | tee -a "$LOG_FILE"
echo "Generated: $(date)" | tee -a "$LOG_FILE"
echo "Hostname : $(hostname)" | tee -a "$LOG_FILE"
echo "==========================================" | tee -a "$LOG_FILE"

#############################################
# CPU Usage
#############################################

CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8}')

echo ""
echo "CPU Usage: ${CPU_USAGE}%" | tee -a "$LOG_FILE"

#############################################
# Memory Usage
#############################################

echo ""
echo "Memory Usage:" | tee -a "$LOG_FILE"

free -h | tee -a "$LOG_FILE"

#############################################
# Disk Usage
#############################################

echo ""
echo "Disk Usage:" | tee -a "$LOG_FILE"

#############################################
# Load Average
#############################################

echo ""
echo "Load Average:" | tee -a "$LOG_FILE"

uptime | tee -a "$LOG_FILE"

#############################################
# Top CPU Processes
#############################################

echo ""
echo "Top 5 CPU Processes:" | tee -a "$LOG_FILE"

ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%cpu | head -6 | tee -a "$LOG_FILE"

#############################################
# Top Memory Processes
#############################################

echo ""
echo "Top 5 Memory Processes:" | tee -a "$LOG_FILE"

ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%mem | head -6 | tee -a "$LOG_FILE"

echo ""
echo "Health Report Completed Successfully." | tee -a "$LOG_FILE"
